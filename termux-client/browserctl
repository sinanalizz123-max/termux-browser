#!/usr/bin/env python3
"""browserctl — Termux CLI for the Termux Browser control API (M2).

Reads endpoint + token from ~/.config/termux-browser/config (mode 0600).
The token is never printed to stdout, never passed as a CLI argument.
"""
import getpass
import json
import os
import sys
import time
import urllib.request
import urllib.error

CONFIG_DIR = os.path.expanduser("~/.config/termux-browser")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config")


def load_config():
    try:
        with open(CONFIG_PATH) as f:
            cfg = json.load(f)
        return cfg["host"], int(cfg["port"]), cfg["token"]
    except (OSError, KeyError, ValueError):
        print("Not connected. Run: browserctl connect", file=sys.stderr)
        sys.exit(2)


def api(method, path, body=None):
    host, port, token = load_config()
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(
        f"http://{host}:{port}/v1{path}",
        data=data,
        method=method,
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read().decode())
        except Exception:
            return e.code, {"http_error": e.code}
    except Exception as e:
        return -1, {"error": str(e)}


def cmd_connect(_args):
    print("Pair with the app: open Termux Browser, tap 'Pair Termux'.")
    host = input("Host [127.0.0.1]: ").strip() or "127.0.0.1"
    port = input("Port: ").strip()
    token = getpass.getpass("Token (paste once, not echoed): ").strip()
    if not port.isdigit() or not token:
        print("connect aborted: need a numeric port and a token.", file=sys.stderr)
        sys.exit(2)
    os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        json.dump({"host": host, "port": int(port), "token": token}, f)
    os.chmod(CONFIG_PATH, 0o600)
    print("Connected. Token stored privately; it is never printed.")


def cmd_status(_args):
    code, body = api("GET", "/status")
    print(json.dumps(body, indent=2))


def cmd_open(args):
    if not args:
        print("usage: browserctl open <url>", file=sys.stderr)
        sys.exit(2)
    code, body = api("POST", "/commands/open", {"url": args[0]})
    print(json.dumps(body, indent=2))


def cmd_search(args):
    if not args:
        print("usage: browserctl search <query>", file=sys.stderr)
        sys.exit(2)
    code, body = api("POST", "/commands/search", {"query": " ".join(args)})
    print(json.dumps(body, indent=2))


def cmd_read(args):
    import argparse
    p = argparse.ArgumentParser(prog="browserctl read")
    p.add_argument("--scope", default="page")
    p.add_argument("--max-chars", type=int, default=20000)
    p.add_argument("--wait", type=int, default=30)
    ns = p.parse_args(args)
    code, body = api("POST", "/commands/read",
                     {"scope": ns.scope, "maxChars": ns.max_chars})
    print(json.dumps(body, indent=2))
    cmd_id = body.get("envelope", {}).get("commandId")
    if cmd_id and ns.wait > 0:
        cmd_result([cmd_id, "--wait", str(ns.wait)])


def cmd_result(args):
    wait = 0
    if "--wait" in args:
        i = args.index("--wait")
        wait = int(args[i + 1])
        args = args[:i] + args[i + 2:]
    if not args:
        print("usage: browserctl result <command-id> [--wait N]", file=sys.stderr)
        sys.exit(2)
    deadline = time.time() + wait
    while True:
        code, body = api("GET", f"/result/{args[0]}")
        if code != 404 or time.time() >= deadline:
            print(json.dumps(body, indent=2))
            return
        time.sleep(1)


def cmd_log(args):
    n = "20"
    if "--last" in args:
        n = args[args.index("--last") + 1]
    code, body = api("GET", "/activity?since=0")
    events = body.get("events", [])
    print(json.dumps(events[-int(n):], indent=2))


def cmd_ai(args):
    import argparse
    p = argparse.ArgumentParser(prog="browserctl ai")
    p.add_argument("site")
    p.add_argument("prompt", nargs="+")
    p.add_argument("--max-chars", type=int, default=20000)
    p.add_argument("--wait", type=int, default=120)
    ns = p.parse_args(args)
    code, body = api("POST", "/commands/ai-chat",
                     {"site": ns.site, "prompt": " ".join(ns.prompt),
                      "maxChars": ns.max_chars})
    print(json.dumps(body, indent=2))
    cmd_id = body.get("envelope", {}).get("commandId")
    if cmd_id and ns.wait > 0:
        cmd_result([cmd_id, "--wait", str(ns.wait)])


def cmd_apichat(args):
    import argparse
    p = argparse.ArgumentParser(prog="browserctl apichat")
    p.add_argument("provider")
    p.add_argument("prompt", nargs="+")
    p.add_argument("--max-chars", type=int, default=20000)
    p.add_argument("--wait", type=int, default=120)
    ns = p.parse_args(args)
    code, body = api("POST", "/commands/api-chat",
                     {"site": ns.provider, "prompt": " ".join(ns.prompt),
                      "maxChars": ns.max_chars})
    print(json.dumps(body, indent=2))
    cmd_id = body.get("envelope", {}).get("commandId")
    if cmd_id and ns.wait > 0:
        cmd_result([cmd_id, "--wait", str(ns.wait)])


def cmd_control(name):
    def run(_args):
        code, body = api("POST", f"/control/{name}")
        print(json.dumps(body, indent=2))
    return run


def cmd_stop_cmd(_args):
    code, body = api("POST", "/commands/stop")
    print(json.dumps(body, indent=2))


def ws_connect(host, port, path, token):
    """Minimal stdlib WebSocket client (hybi-13). No third-party deps."""
    import base64
    import hashlib
    import socket
    import struct
    s = socket.create_connection((host, port), timeout=10)
    key = base64.b64encode(os.urandom(16)).decode()
    s.sendall(
        (f"GET {path} HTTP/1.1\r\nHost: {host}:{port}\r\n"
         "Upgrade: websocket\r\nConnection: Upgrade\r\n"
         f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n"
         f"Authorization: Bearer {token}\r\n\r\n").encode()
    )
    head = b""
    while b"\r\n\r\n" not in head:
        chunk = s.recv(4096)
        if not chunk:
            raise ConnectionError("handshake closed")
        head += chunk
    status = head.split(b"\r\n", 1)[0].decode()
    if " 101 " not in status:
        raise ConnectionError(f"handshake failed: {status}")
    return s


def ws_recv_text(s):
    """Read one message; answers pings, raises on close/error."""
    import socket
    import struct
    buf = b""

    def read(n):
        nonlocal buf
        while len(buf) < n:
            chunk = s.recv(max(n - len(buf), 1))
            if not chunk:
                raise ConnectionError("socket closed")
            buf += chunk
        out, buf = buf[:n], buf[n:]
        return out

    message = b""
    while True:
        b1, b2 = read(2)
        fin = b1 & 0x80
        opcode = b1 & 0x0F
        length = b2 & 0x7F
        if length == 126:
            length = struct.unpack(">H", read(2))[0]
        elif length == 127:
            length = struct.unpack(">Q", read(8))[0]
        payload = read(length)
        if opcode == 0x8:
            raise ConnectionError("server closed stream")
        if opcode == 0x9:
            masked = os.urandom(4)
            frame = bytes([0x8A, 0x80 | len(payload)])
            frame += masked + bytes(c ^ masked[i % 4] for i, c in enumerate(payload))
            s.sendall(frame)
            continue
        if opcode in (0x1, 0x0, 0x2):
            message += payload
            if fin:
                return message.decode("utf-8", "replace")


def cmd_watch(_args):
    import json as _json
    host, port, token = load_config()
    try:
        with open(os.path.expanduser("~/.config/termux-browser/last-event")) as f:
            since = int(f.read().strip() or 0)
    except (OSError, ValueError):
        since = 0
    backoff, last_saved = 1, since
    while True:
        try:
            s = ws_connect(host, port, f"/v1/events?since={since}", token)
            backoff = 1
            while True:
                body = _json.loads(ws_recv_text(s))
                if body.get("type") == "history_gap":
                    print("history gap: resynchronizing from status", file=sys.stderr)
                    since = 0
                    break
                eid = body.get("eventId", since)
                print(f"[{body.get('type')}] {body.get('commandId', '')} "
                      f"{body.get('state', '')} {body.get('detail', '')[:160]}")
                since = max(since, eid)
                if since != last_saved:
                    with open(os.path.expanduser("~/.config/termux-browser/last-event"),
                              "w") as f:
                        f.write(str(since))
                    os.chmod(os.path.expanduser("~/.config/termux-browser/last-event"),
                             0o600)
                    last_saved = since
        except KeyboardInterrupt:
            return
        except Exception as e:
            print(f"watch disconnected ({e}); retrying in {backoff}s", file=sys.stderr)
            time.sleep(backoff)
            backoff = min(backoff * 2, 30)


COMMANDS = {
    "connect": cmd_connect,
    "ai": cmd_ai,
    "apichat": cmd_apichat,
    "status": cmd_status,
    "open": cmd_open,
    "search": cmd_search,
    "read": cmd_read,
    "result": cmd_result,
    "log": cmd_log,
    "pause": cmd_control("pause"),
    "resume": cmd_control("resume"),
    "control-stop": cmd_control("stop"),
    "stop": cmd_stop_cmd,
    "watch": cmd_watch,
}


def main(argv):
    if len(argv) < 2 or argv[1] not in COMMANDS:
        print("usage: browserctl {" + "|".join(sorted(COMMANDS)) + "}", file=sys.stderr)
        sys.exit(2)
    COMMANDS[argv[1]](argv[2:])


if __name__ == "__main__":
    main(sys.argv)
