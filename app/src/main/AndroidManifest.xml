<?xml version="1.0" encoding="utf-8"?>
<!-- M1: backups disabled deliberately. The WebView profile is a credential
    vault (cookies, sessions, AI conversations); nothing here is safe to
    cloud-back until a narrow backup policy exists. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".BrowserActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- M6: automation foreground service. specialUse documents the
            user-visible automation session; started only during the
            foreground-to-background transition while automation executes. -->
        <service
            android:name=".AutomationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-visible browser automation session with on-screen stop controls." />
        </service>
        <receiver
            android:name=".ControlReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.termux.browser.ACTION_PAUSE" />
                <action android:name="com.termux.browser.ACTION_RESUME" />
                <action android:name="com.termux.browser.ACTION_STOP" />
                <action android:name="com.termux.browser.ACTION_OPEN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
